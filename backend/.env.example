# ============================================================================
# POS API — environment example (NO real secrets). Copy to .env and fill in.
# Termux/server: cp backend/.env.example backend/.env
# ============================================================================

NODE_ENV=development              # development | production
PORT=4000

# --- Database (required) ----------------------------------------------------
DATABASE_URL=postgres://pos:CHANGE_ME@localhost:5432/posdb

# --- Auth (all REQUIRED in production) -------------------------------------
JWT_SECRET=change-me-64-random-chars
ADMIN_JWT_SECRET=change-me-too-64-random-chars
ADMIN_EMAIL=admin@pos.local
ADMIN_PASSWORD=change-me

# --- Public URLs ------------------------------------------------------------
# HTTPS in deployed environments. App ka default publicBase configure hota hai
# (Settings → कनेक्शन) — backend sirf OG metadata me this origin use karta hai.
PUBLIC_SHOP_ORIGIN=https://dukan.example.com        # public web store origin
MEDIA_URL_BASE=https://api.example.com/media        # uploaded image base URL
UPLOAD_DIR=./uploads

# --- PART 6 — shop-link sharing / OG metadata (OPTIONAL) ---------------------
# Production में PUBLIC_SHOP_ORIGIN https:// ही चलेगा (server start ही नहीं होगा वरना).
# संदेश-टेम्पलेट: {shop_name} व {shop_url} placeholders; खाली छोड़ें तो हिंदी default.
SHARE_TEXT_TEMPLATE=
# लोगो/कवर न होने पर OG इमेज (absolute https URL; PNG/JPG ही — OG में SVG नहीं).
# Default: <PUBLIC_SHOP_ORIGIN>/og-default.png (customer-web/public/ में फ़ाइल जुड़ी है).
OG_DEFAULT_IMAGE_URL=
# WhatsApp/Facebook OG cache कभी-कभी पुराना प्रीव्यू दिखाता है — हर हाल में
# तुरंत अपडेट की गारंटी कोई नहीं (facebook Sharing Debugger से री-स्क्रैप कर सकते हैं).

# --- SMS provider ------------------------------------------------------------
# console : DEV-ONLY — sends nothing; devCode returned in API response (dev env
#           only) so the on-screen DEV banner works. Never enabled in prod.
# http    : generic JSON gateway (see SMS_API_URL). For msg91 / twilio write a
#           small adapter implementing SmsProvider interface.
SMS_PROVIDER=console
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER=POSDUKAN

# --- OTP (server-enforced) ---------------------------------------------------
OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_MAX_PER_30MIN=5

# --- PART 5 — push notifications (OPTIONAL) ----------------------------------
# खाली छूटेगी तो सिर्फ़ in-app notification इतिहास भरता है (merchant ऐप की
# #/notifs सूची) और outbox हर row पर साफ़ note रखता है. FCM की key source
# code में कभी नहीं — सिर्फ़ यहाँ (.env). Firebase console → Project →
# Cloud Messaging → Server key (legacy server key).
FCM_SERVER_KEY=
NOTIFIER_INTERVAL_MS=20000

# --- Migrations ---------------------------------------------------------------
# Repo-relative default: ../database/migrations (SQL files 001…, applied on boot)
MIGRATIONS_DIR=

# --- PART 7 — Admin panel (roles/complaints/policies) ---------------------------
# पहला SUPER_ADMIN अपने-आप बनता है (admin_users खाली + ये दोनों) —
# ADMIN_EMAIL/ADMIN_PASSWORD, phir Admin panel → एडमिन्स से और बनाएं (scrypt).
# Tokens 12 घंटे; पासवर्ड DB में scrypt हैश (plaintext कभी नहीं).
# ADMIN_JWT_SECRET JWT_SECRET से अलग रखें (admin दुनिया की सीमा डवलपर साफ़).
