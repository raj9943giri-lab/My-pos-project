# SOS Local Dukaan कस्टमर स्टोर का environment
# copy → .env.local

# Backend (NestJS) का base URL — dev में Termux/लैपटॉप पर वही host
NEXT_PUBLIC_API_BASE=http://localhost:4000
# (SSR सेवर साइड fetch के लिए अलग base चाहिए तो यह; नहीं तो NEXT_PUBLIC_API_BASE ही चलता है)
# API_BASE=http://localhost:4000

# दुकान का सार्वजनिक domain (OG meta में लिंक यहीं पर बनते हैं)
NEXT_PUBLIC_SITE_URL=https://dukan.example.com
